{
  "name": "@stackfast/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "seed": "dotenv -e ../../.env -- tsx src/db/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@neondatabase/serverless": "^0.10.4",
    "@sentry/node": "^10.53.1",
    "@stackfast/ai": "workspace:*",
    "@stackfast/exporter": "workspace:*",
    "@stackfast/registry": "workspace:*",
    "@stackfast/rules-engine": "workspace:*",
    "@stackfast/schemas": "workspace:*",
    "@stackfast/shared": "workspace:*",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "better-auth": "^1.1.13",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.4",
    "fast-check": "^4.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
