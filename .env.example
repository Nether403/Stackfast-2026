# Database Configuration
# PostgreSQL connection string for Neon or other PostgreSQL provider
DATABASE_URL=postgresql://username:password@hostname/database

# Optional: API Keys for external data sources
# GitHub API token for enhanced GitHub integration
GITHUB_TOKEN=github_pat_your_token_here

# Product Hunt API token for Product Hunt data
PRODUCTHUNT_TOKEN=your_producthunt_token_here

# Back4App API credentials for external data sources
BACK4APP_APP_ID=X4zHblrpTF5ZhOwoKXzm6PhPpUQCQLrmZoKPBAoS
BACK4APP_API_KEY=your_back4app_api_key_here

# Server Configuration
NODE_ENV=development
PORT=5000

# Replit-specific (can be removed if not using Replit)
REPL_ID=your_replit_id
